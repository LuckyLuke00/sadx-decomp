#!/bin/sh
# Records the scores, history row and visuals of every commit, and stages them.
# save builds the working tree, so a commit must hold all of it: no unstaged edits.
# Enable once per clone with: git config core.hooksPath .githooks
if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard src)" ]; then
	echo "pre-commit: stage all changes first (git add -A). check.py save scores the whole working tree."
	exit 1
fi
python tools/check.py save || exit 1
git add README.md docs/progress
